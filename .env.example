# Copy to .env.local and fill in. `.env.local` is git-ignored.
#
# Local (Supabase in Docker/OrbStack): run `npm run db:start`, then use the
# "Project URL" and "Publishable key" it prints. For a phone, use your
# computer's LAN or Tailscale IP instead of 127.0.0.1.
#
# Hosted Supabase: Project Settings > API. The publishable key is safe to ship
# in the app; row level security protects the data. Never put the secret /
# service_role key here: anything prefixed EXPO_PUBLIC_ is bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Share and promoter links. Leave empty locally to use the share function on
# your Supabase URL; in production, route eventspace.mv/e/* to the function.
EXPO_PUBLIC_SHARE_URL=

# Facebook App ID, required by Instagram to share straight to Stories
# (developers.facebook.com > My Apps). Without it, sharing uses the share sheet.
EXPO_PUBLIC_FACEBOOK_APP_ID=
