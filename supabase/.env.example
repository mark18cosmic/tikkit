# Copy to supabase/.env (git-ignored). Read by the local Supabase server.
#
# Google sign-in: in Google Cloud Console create an OAuth client ID of type
# "Web application" with this authorised redirect URI:
#   http://127.0.0.1:54321/auth/v1/callback
# Then restart with `npm run db:stop && npm run db:start`.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Card payments (BML Connect). Get keys from the BML merchant portal, then
# set card_provider = 'bml' in private.settings. For hosted projects use
# `npx supabase secrets set BML_API_KEY=... BML_MODE=production`.
BML_API_KEY=
BML_MODE=sandbox
RETURN_URL_PREFIXES=eventspace://,https://eventspace.mv/
