{
  "name": "eventspace",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "supabase": "^2.120.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "go": "expo start --go",
    "go:tunnel": "expo start --go --tunnel",
    "ios": "expo run:ios",
    "ios:se": "expo run:ios --device \"iPhone SE (3rd generation)\"",
    "ios:max": "expo run:ios --device \"iPhone 17 Pro Max\"",
    "ios:dark": "xcrun simctl boot \"iPhone 17\" 2>/dev/null; xcrun simctl ui booted appearance dark && expo run:ios --device \"iPhone 17\"",
    "ios:light": "xcrun simctl ui booted appearance light",
    "android": "expo run:android",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "doctor": "expo-doctor",
    "db:start": "supabase start -x edge-runtime,logflare,vector,imgproxy,supavisor,realtime,studio,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts",
    "db:test": "supabase test db"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo"
  }
}
